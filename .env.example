# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info

# Dedicated ZENOX Finance PostgreSQL database only.
# Do not point this at the ZENOX FRET database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/zenox_finance

# Random secret of at least 32 bytes for local development.
# Production service-to-service authentication must use managed secrets and rotation.
FINANCE_SERVICE_TOKEN=replace-with-a-local-random-secret-at-least-32-bytes

# Supabase Auth for the dedicated ZENOX Finance project only.
# Use the project URL and publishable/anon key. Never put a service_role key here.
SUPABASE_URL=https://YOUR_FINANCE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-the-finance-project-publishable-or-anon-key
